// Jenkins CI/CD pipeline for the Food Delivery ECS Fargate deployment.
//
// Required on the Jenkins Linux agent:
// - Git
// - Node.js 20 and npm
// - Docker Engine
// - AWS CLI v2
// - AWS credentials or, preferably, an EC2 IAM instance role
//
// The AWS identity requires:
// - sts:GetCallerIdentity
// - ECR push permissions
// - ecs:UpdateService
// - ecs:DescribeServices

pipeline {
  agent any

  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds()
    timestamps()
    timeout(time: 90, unit: 'MINUTES')
    buildDiscarder(
      logRotator(
        numToKeepStr: '20',
        artifactNumToKeepStr: '5'
      )
    )
  }

  parameters {
    string(
      name: 'AWS_REGION',
      defaultValue: 'ap-south-1',
      description: 'AWS deployment region'
    )

    string(
      name: 'ECS_CLUSTER_NAME',
      defaultValue: 'food-delivery-prod-cluster',
      description: 'Existing ECS Fargate cluster'
    )

    string(
      name: 'BASE_DOMAIN',
      defaultValue: 'myfooddeliveryproject.work.gd',
      description: 'Production base domain'
    )

    password(
      name: 'GOOGLE_MAPS_API_KEY',
      defaultValue: '',
      description: 'Browser-restricted Google Maps API key'
    )
  }

  environment {
    BACKENDS = '''
      auth-service
      order-service
      payment-service
      tracking-service
      catalog-service
    '''

    FRONTENDS = '''
      auth-app
      customer-app
      restaurant-app
      delivery-app
      admin-panel
    '''
  }

  stages {
    stage('Checkout') {
      steps {
        deleteDir()
        checkout scm
      }
    }

    stage('Prepare Deployment') {
      steps {
        script {
          env.AWS_ACCOUNT_ID = sh(
            script: """
              aws sts get-caller-identity \
                --query Account \
                --output text
            """,
            returnStdout: true
          ).trim()

          if (!env.AWS_ACCOUNT_ID) {
            error('Unable to retrieve the AWS account ID.')
          }

          env.ECR_REGISTRY =
            "${env.AWS_ACCOUNT_ID}.dkr.ecr.${params.AWS_REGION}.amazonaws.com"

          def shortCommit = env.GIT_COMMIT
            ? env.GIT_COMMIT.take(7)
            : 'unknown'

          env.IMAGE_TAG =
            "${env.BUILD_NUMBER}-${shortCommit}"

          echo """
Deployment configuration:
AWS account: ${env.AWS_ACCOUNT_ID}
AWS region:  ${params.AWS_REGION}
ECS cluster: ${params.ECS_CLUSTER_NAME}
Domain:      ${params.BASE_DOMAIN}
Image tag:   ${env.IMAGE_TAG}
Registry:    ${env.ECR_REGISTRY}
"""
        }
      }
    }

    stage('Validate Tools') {
      steps {
        sh '''
          set -eu

          git --version
          node --version
          npm --version
          docker version
          aws --version
        '''
      }
    }

    stage('Validate Frontends') {
      steps {
        script {
          getServices(env.FRONTENDS).each { app ->
            dir("apps/${app}") {
              sh """
                set -eu

                echo "Installing dependencies for ${app}"

                if [ -f package-lock.json ]; then
                  npm ci
                else
                  npm install
                fi

                echo "Validating frontend build: ${app}"
                npm run build
              """
            }
          }
        }
      }
    }

    stage('Validate Backends') {
      steps {
        script {
          getServices(env.BACKENDS).each { service ->
            dir("services/${service}") {
              sh """
                set -eu

                echo "Installing dependencies for ${service}"

                if [ -f package-lock.json ]; then
                  npm ci
                else
                  npm install
                fi

                echo "Checking JavaScript syntax: ${service}"

                find src \
                  -type f \
                  -name '*.js' \
                  -print0 |
                xargs -0 -n1 node --check
              """
            }
          }
        }
      }
    }

    stage('ECR Login') {
      steps {
        sh """
          set -eu

          aws ecr get-login-password \
            --region '${params.AWS_REGION}' |
          docker login \
            --username AWS \
            --password-stdin '${env.ECR_REGISTRY}'
        """
      }
    }

    stage('Build and Push Backends') {
      steps {
        script {
          getServices(env.BACKENDS).each { service ->
            def versionedImage =
              "${env.ECR_REGISTRY}/${service}:${env.IMAGE_TAG}"

            def latestImage =
              "${env.ECR_REGISTRY}/${service}:latest"

            sh """
              set -eu

              echo "Building backend: ${service}"

              docker build \
                --pull \
                --provenance=false \
                -t '${versionedImage}' \
                -t '${latestImage}' \
                'services/${service}'

              echo "Pushing backend: ${service}"

              docker push '${versionedImage}'
              docker push '${latestImage}'
            """
          }
        }
      }
    }

    stage('Build and Push Frontends') {
      steps {
        script {
          def apiUrl =
            "https://api.${params.BASE_DOMAIN}"

          def frontendBuildArguments = [
            'auth-app': """
              --build-arg VITE_AUTH_API_URL=${apiUrl}
              --build-arg VITE_CUSTOMER_APP_URL=https://customer.${params.BASE_DOMAIN}
              --build-arg VITE_RESTAURANT_APP_URL=https://restaurant.${params.BASE_DOMAIN}
              --build-arg VITE_DELIVERY_APP_URL=https://delivery.${params.BASE_DOMAIN}
              --build-arg VITE_ADMIN_APP_URL=https://admin.${params.BASE_DOMAIN}
            """.trim().replaceAll(/\s+/, ' '),

            'customer-app': """
              --build-arg VITE_AUTH_API_URL=${apiUrl}
              --build-arg VITE_ORDER_SERVICE_URL=${apiUrl}
              --build-arg VITE_PAYMENT_SERVICE_URL=${apiUrl}
              --build-arg VITE_TRACKING_SERVICE_URL=${apiUrl}
              --build-arg VITE_CATALOG_SERVICE_URL=${apiUrl}
              --build-arg VITE_AUTH_APP_URL=https://auth.${params.BASE_DOMAIN}
              --build-arg VITE_RESTAURANT_ID=11111111-1111-1111-1111-111111111111
              --build-arg VITE_GOOGLE_MAPS_API_KEY=${params.GOOGLE_MAPS_API_KEY}
            """.trim().replaceAll(/\s+/, ' '),

            'restaurant-app': """
              --build-arg VITE_AUTH_API_URL=${apiUrl}
              --build-arg VITE_ORDER_SERVICE_URL=${apiUrl}
              --build-arg VITE_PAYMENT_SERVICE_URL=${apiUrl}
              --build-arg VITE_TRACKING_SERVICE_URL=${apiUrl}
              --build-arg VITE_CATALOG_SERVICE_URL=${apiUrl}
              --build-arg VITE_AUTH_APP_URL=https://auth.${params.BASE_DOMAIN}
              --build-arg VITE_RESTAURANT_ID=11111111-1111-1111-1111-111111111111
            """.trim().replaceAll(/\s+/, ' '),

            'delivery-app': """
              --build-arg VITE_AUTH_API_URL=${apiUrl}
              --build-arg VITE_ORDER_SERVICE_URL=${apiUrl}
              --build-arg VITE_PAYMENT_SERVICE_URL=${apiUrl}
              --build-arg VITE_TRACKING_SERVICE_URL=${apiUrl}
              --build-arg VITE_AUTH_APP_URL=https://auth.${params.BASE_DOMAIN}
            """.trim().replaceAll(/\s+/, ' '),

            'admin-panel': """
              --build-arg VITE_AUTH_API_URL=${apiUrl}
              --build-arg VITE_ORDER_SERVICE_URL=${apiUrl}
              --build-arg VITE_PAYMENT_SERVICE_URL=${apiUrl}
              --build-arg VITE_TRACKING_SERVICE_URL=${apiUrl}
              --build-arg VITE_CATALOG_SERVICE_URL=${apiUrl}
              --build-arg VITE_AUTH_APP_URL=https://auth.${params.BASE_DOMAIN}
            """.trim().replaceAll(/\s+/, ' ')
          ]

          getServices(env.FRONTENDS).each { app ->
            def versionedImage =
              "${env.ECR_REGISTRY}/${app}:${env.IMAGE_TAG}"

            def latestImage =
              "${env.ECR_REGISTRY}/${app}:latest"

            def buildArguments =
              frontendBuildArguments[app]

            if (!buildArguments) {
              error("No frontend build arguments configured for ${app}")
            }

            sh """
              set -eu

              echo "Building frontend: ${app}"

              docker build \
                --pull \
                --provenance=false \
                ${buildArguments} \
                -t '${versionedImage}' \
                -t '${latestImage}' \
                'apps/${app}'

              echo "Pushing frontend: ${app}"

              docker push '${versionedImage}'
              docker push '${latestImage}'
            """
          }
        }
      }
    }

    stage('Deploy ECS') {
      steps {
        script {
          def allServices =
            getServices(env.BACKENDS) +
            getServices(env.FRONTENDS)

          allServices.each { service ->
            sh """
              set -eu

              echo "Deploying ECS service: ${service}"

              aws ecs update-service \
                --cluster '${params.ECS_CLUSTER_NAME}' \
                --service '${service}' \
                --force-new-deployment \
                --region '${params.AWS_REGION}' \
                --query 'service.{Service:serviceName,Status:status,Desired:desiredCount}' \
                --output table
            """
          }
        }
      }
    }

    stage('Wait for ECS Stability') {
      steps {
        script {
          def allServices =
            getServices(env.BACKENDS) +
            getServices(env.FRONTENDS)

          sh """
            set -eu

            echo "Waiting for all ECS services to stabilize"

            aws ecs wait services-stable \
              --cluster '${params.ECS_CLUSTER_NAME}' \
              --services ${allServices.collect { "'${it}'" }.join(' ')} \
              --region '${params.AWS_REGION}'
          """
        }
      }
    }

    stage('Verify ECS Services') {
      steps {
        script {
          def allServices =
            getServices(env.BACKENDS) +
            getServices(env.FRONTENDS)

          sh """
            set -eu

            aws ecs describe-services \
              --cluster '${params.ECS_CLUSTER_NAME}' \
              --services ${allServices.collect { "'${it}'" }.join(' ')} \
              --region '${params.AWS_REGION}' \
              --query 'services[].{Service:serviceName,Status:status,Desired:desiredCount,Running:runningCount,Pending:pendingCount}' \
              --output table
          """
        }
      }
    }

    stage('HTTPS Smoke Test') {
      steps {
        sh """
          set -eu

          test_url() {
            url="\$1"

            echo "Testing: \$url"

            curl \
              --fail \
              --silent \
              --show-error \
              --location \
              --retry 6 \
              --retry-delay 10 \
              --connect-timeout 15 \
              --max-time 60 \
              "\$url" \
              > /dev/null
          }

          test_url 'https://api.${params.BASE_DOMAIN}/health'
          test_url 'https://auth.${params.BASE_DOMAIN}'
          test_url 'https://customer.${params.BASE_DOMAIN}'
          test_url 'https://restaurant.${params.BASE_DOMAIN}'
          test_url 'https://delivery.${params.BASE_DOMAIN}'
          test_url 'https://admin.${params.BASE_DOMAIN}'

          echo "All HTTPS smoke tests passed."
        """
      }
    }
  }

  post {
    success {
      echo """
Deployment succeeded.

Image tag: ${env.IMAGE_TAG}
Domain:    https://${params.BASE_DOMAIN}
Cluster:   ${params.ECS_CLUSTER_NAME}
"""
    }

    unsuccessful {
      echo """
Deployment failed.

Review:
- Jenkins console output
- ECS service events
- ECS stopped-task reasons
- CloudWatch log groups
"""
    }

    always {
      sh '''
        docker logout "${ECR_REGISTRY}" || true
        docker image prune --force || true
        docker builder prune --force || true
      '''

      cleanWs(
        deleteDirs: true,
        disableDeferredWipeout: true,
        notFailBuild: true
      )
    }
  }
}

def getServices(String value) {
  return value
    .trim()
    .split(/\s+/)
    .findAll { it }
}